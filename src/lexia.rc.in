// The version resource of lexia.exe (what Explorer's Properties > Details shows).
// Generated by CMake from the version in vcpkg.json; edit src/lexia.rc.in, not the copy in the build folder.
#pragma code_page(65001)
#include <winver.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/src/resource_ids.h"

// Icons: the lowest id is the exe's icon. Made by scripts/make_tray_icons.ps1 from the logo SVGs src/res/lexia_logo.svg (On) and lexia_logo_off.svg (Off).
IDI_LEXIA ICON "@CMAKE_CURRENT_SOURCE_DIR@/src/res/lexia.ico"
IDI_LEXIA_OFF ICON "@CMAKE_CURRENT_SOURCE_DIR@/src/res/lexia_off.ico"

#define LEXIA_FILEVERSION_NUMBERS @Lexia_VERSION_MAJOR@,@Lexia_VERSION_MINOR@,@Lexia_VERSION_PATCH@,0

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LEXIA_FILEVERSION_NUMBERS
 PRODUCTVERSION LEXIA_FILEVERSION_NUMBERS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"  // US English, Unicode
        BEGIN
            VALUE "CompanyName", "Eleonora Predeva"
            VALUE "FileDescription", "Lexia - reads text on your screen out loud"
            VALUE "FileVersion", "@Lexia_VERSION@.0"
            VALUE "InternalName", "lexia"
            VALUE "LegalCopyright", "Copyright (C) 2026 Eleonora Predeva. Free software under the GNU GPL, version 3 or later (GPL-3.0-or-later)."
            VALUE "OriginalFilename", "lexia.exe"
            VALUE "ProductName", "Lexia"
            VALUE "ProductVersion", "@Lexia_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
