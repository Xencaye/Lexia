#pragma once
// Lexia's version. Generated by CMake from "version" in vcpkg.json (the one source of truth);
// edit that, never this. Win32-free, so About, Report bug and lexia_cli --version can all use it.

#define LEXIA_VERSION_MAJOR @Lexia_VERSION_MAJOR@
#define LEXIA_VERSION_MINOR @Lexia_VERSION_MINOR@
#define LEXIA_VERSION_PATCH @Lexia_VERSION_PATCH@

// "major.minor.patch", e.g. "0.5.0".
#define LEXIA_VERSION "@Lexia_VERSION@"
